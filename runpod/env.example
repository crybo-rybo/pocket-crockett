# RunPod / training environment template. Copy to .env on the pod (never commit secrets).

# --- R2 (shard pull + checkpoint upload) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pocket-crockett-vision
R2_SHARD_PREFIX=vision-shards/
R2_CHECKPOINT_PREFIX=model-checkpoints/

# --- Bootstrap paths ---
SHARD_DIR=/workspace/shards
DATA_ROOT=/workspace/data
R2_REMOTE=r2

# --- Training paths ---
OUTPUT_DIR=/workspace/runs
REPO_ROOT=/workspace/pocket-crockett

# --- Optional bootstrap overrides ---
# SHARDS="train-000.tar val-000.tar"
# INCLUDE_PRETRAINING=0
# SKIP_PULL=0
# SKIP_UNPACK=0
