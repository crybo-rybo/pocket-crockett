# Copy this file to `.env` (gitignored) and fill in the values.
# `tools/upload_to_r2.py` reads these on startup. Variables already
# exported in your shell take precedence over what's in `.env`.

# Cloudflare account ID — the bare hex string shown in the R2 dashboard
# under "Account Details" -> "Account ID". (The "S3 API" row on the same
# panel is just https://<account_id>.r2.cloudflarestorage.com; you only
# need the hex part, not the full URL.)
R2_ACCOUNT_ID=

# R2 API token with read+write on the bucket below.
# Generate under: R2 -> Manage R2 API Tokens -> Create API Token.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The private bucket that stores the vision tar shards.
R2_BUCKET=pocket-crockett-vision
